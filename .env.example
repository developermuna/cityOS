# Ola Maps API Configuration
# 1. Login to https://maps.olamaps.io/
# 2. Go to 'Products' and enable 'Maps SDK' and 'Places SDK'
# 3. Go to 'Credentials' to create/copy your API key
# 4. If using domain restrictions, whitelist: localhost and your app domain
VITE_OLA_MAPS_API_KEY=your_ola_maps_api_key_here
VITE_OLA_MAPS_CLIENT_SECRET=your_ola_maps_client_secret_here
